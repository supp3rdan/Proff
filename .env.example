# Coloque pelo menos uma chave. A ordem de tentativa é Gemini → Groq → OpenRouter.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Modelos (opcional; estes são os padrões)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free

# Código de acesso pedido na tela (recomendado ao publicar na internet)
# APP_SENHA=

# Modo simulado: 1 = não chama nenhuma API (útil para testar a interface)
# LLM_MOCK=1
