# Coloque pelo menos uma chave. A ordem de tentativa é Groq → Gemini → OpenRouter.
# No Groq: Llama 3.3 70B para texto e gpt-oss-120b para matemática.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Modelos (opcional; estes são os padrões)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=  (deixe vazio para usar Llama no texto e gpt-oss na matemática)
# OPENROUTER_MODEL=openrouter/free

# Código de acesso pedido na tela (recomendado ao publicar na internet)
# APP_SENHA=

# Modo simulado: 1 = não chama nenhuma API (útil para testar a interface)
# LLM_MOCK=1
