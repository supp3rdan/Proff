# ===== Supabase (Project Settings → API) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# chave secreta: só no servidor (Vercel), nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# ===== IA (pelo menos uma) =====
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Modelos (opcional): deixe vazio para Llama no texto e gpt-oss na matemática (Groq)
# GROQ_MODEL=
# GEMINI_MODEL=gemini-3.8-flash
# OPENROUTER_MODEL=openrouter/free

# ===== Fila em segundo plano =====
# texto aleatório e longo (ex.: openssl rand -hex 32); protege o worker e a função SymPy
WORKER_SECRET=
# endereço do site em produção (ex.: https://proff.vercel.app); nos previews a Vercel usa o próprio endereço
# APP_URL=

# ===== Limites (opcional) =====
# LIMITE_DIARIO=400
# LLM_TIMEOUT_MS=90000

# ===== Desenvolvimento local sem Supabase e sem IA =====
# DB_MEMORIA=1
# LLM_MOCK=1
